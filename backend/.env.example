# Copy this file to backend/.env and adjust the values.
NODE_ENV=development
PORT=4000

# Matches the Postgres service exposed by docker-compose.yml.
DATABASE_URL="postgresql://collabspace:collabspace@localhost:55432/collabspace?schema=public"

# Must be at least 32 characters. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-random-string-at-least-32-characters"
JWT_EXPIRES_IN="7d"

# Comma-separated list of allowed frontend origins.
CORS_ORIGIN="http://localhost:5173"
